   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A Japanese woman in traditional Kimono is holding a sun umbrella.  She is standing on a street in Kyoto and has flowers in her hair.  In the background, there are two other Japanese women who are also wearing a traditional Kimono and they are talking to each other.</rdf:li>
    </rdf:Alt>
   </dc:description>
